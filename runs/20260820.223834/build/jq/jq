#!/usr/bin/env python3
import sys,json,re,math,base64,urllib.parse,html

class CompileError(Exception): pass
class RuntimeErrorJQ(Exception):
 def __init__(self,value='runtime error'):
  self.value=value
  super().__init__(str(value))
class Tok:
 def __init__(self,k,v,pos=0): self.k,self.v,self.pos=k,v,pos
 def __repr__(self): return f'{self.k}:{self.v!r}'

KEYS={'as','def','module','include','if','then','else','elif','end','and','or','reduce','foreach','try','catch','label','break'}
OPS=['//=','?//','!=','==','|=','+=','-=','*=','/=','%=','<=','>=','//','..']
def lex(s):
 out=[]; i=0; n=len(s)
 while i<n:
  c=s[i]
  if c.isspace(): i+=1; continue
  if c=='#':
   i+=1
   while i<n and s[i]!='\n': i+=1
   # A comment continues over the following newline only when the
   # final run of backslashes has odd length.
   while i<n and s[i]=='\n':
    j=i-1; count=0
    while j>=0 and s[j]=='\\': count+=1; j-=1
    if count%2==0: break
    i+=1
    while i<n and s[i]!='\n': i+=1
   continue
  if s.startswith('\\(',i): out.append(Tok('INTERP','\\(',i)); i+=2; continue
  if c=='"':
   st=i; i+=1; esc=False; interp=0
   while i<n:
    if s.startswith('\\(',i) and not esc: interp+=1; i+=2; continue
    if s[i]==')' and interp and not esc: interp-=1; i+=1; continue
    if s[i]=='"' and not esc and interp==0: i+=1; break
    if s[i]=='\n' and not esc: raise CompileError('unterminated string')
    if s[i]=='\\' and not esc: esc=True
    else: esc=False
    i+=1
   else: raise CompileError('unterminated string')
   raw=s[st:i]
   if '\\(' in raw:
    body=raw[1:-1]; pieces=[]; cur=''; j=0
    while j<len(body):
     if body.startswith('\\(',j):
      if cur:
       try: pieces.append(json.loads('"'+cur+'"'))
       except Exception: raise CompileError('invalid string escape')
       cur=''
      depth=1; q=j+2
      while q<len(body) and depth:
       depth += (body[q]=='(')-(body[q]==')'); q+=1
      pieces.append('\\I'+body[j+2:q-1]+'\\E'); j=q
     else: cur+=body[j]; j+=1
    if cur:
     try: pieces.append(json.loads('"'+cur+'"'))
     except Exception: raise CompileError('invalid string escape')
    val=''.join(pieces)
   else:
    try: val=json.loads(raw)
    except Exception: raise CompileError('invalid string escape')
   out.append(Tok('STR',val,st)); continue
  if c=='$':
   m=re.match(r'\$([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)',s[i:])
   if not m: raise CompileError('invalid binding')
   out.append(Tok('VAR',m.group(1),i)); i+=len(m.group(0)); continue
  if c=='@':
   m=re.match(r'@[A-Za-z0-9_]+',s[i:]);
   if not m: raise CompileError('invalid format')
   out.append(Tok('FORMAT',m.group(0)[1:],i)); i+=len(m.group(0)); continue
  if c=='.' and i+1<n and s[i+1].isdigit():
   m=re.match(r'\.[0-9]+(?:[eE][+-]?[0-9]+)?',s[i:]); out.append(Tok('NUM',m.group(0),i)); i+=len(m.group(0)); continue
  if c.isdigit():
   m=re.match(r'(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?',s[i:]); out.append(Tok('NUM',m.group(0),i)); i+=len(m.group(0)); continue
  if c=='.' and i+1<n and re.match(r'[A-Za-z_]',s[i+1]):
   m=re.match(r'\.([A-Za-z_][A-Za-z0-9_]*)',s[i:]); out.append(Tok('FIELD',m.group(1),i)); i+=len(m.group(0)); continue
  if c.isalpha() or c=='_':
   m=re.match(r'[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*',s[i:]); v=m.group(0); out.append(Tok(v if v in KEYS else 'ID',v,i)); i+=len(v); continue
  found=next((op for op in OPS if s.startswith(op,i)),None)
  if found: out.append(Tok(found,found,i)); i+=len(found); continue
  if c in '.[]{}(),:;|+-*/%=?<>': out.append(Tok(c,c,i)); i+=1; continue
  raise CompileError('invalid character')
 out.append(Tok('EOF','',n)); return out

class Parser:
 def __init__(self,s): self.t=lex(s); self.i=0
 def peek(self,*ks): return self.t[self.i].k in ks
 def pop(self,k=None):
  x=self.t[self.i]
  if k and x.k!=k: raise CompileError('syntax error')
  self.i+=1; return x
 def program(self):
  if self.peek('module','include'): raise CompileError('module unavailable')
  # declarations are accepted and skipped into a local function table
  defs={}
  while self.peek('def'):
   self.pop(); name=self.pop('ID').v
   params=[]
   if self.peek('('):
    self.pop()
    if not self.peek(')'):
     while True:
      p=self.pop()
      if p.k not in ('ID','VAR'): raise CompileError('invalid function parameter')
      params.append((p.v, p.k=='VAR'))
      if self.peek(';'): self.pop(); continue
      break
    self.pop(')')
   self.pop(':'); start=self.i; depth=0; nested_defs=0
   while True:
    if self.peek(';') and depth==0:
     if nested_defs: nested_defs-=1; self.pop(); continue
     break
    x=self.pop(); depth += (x.k in '([{')-(x.k in ')]}')
    if x.k=='def': nested_defs+=1
   body_tokens=self._slice(start,self.i); self.pop(';')
   body_parser=Parser(''); body_parser.t=body_tokens; body_parser.i=0
   try: body_node, inner_defs=body_parser.program()
   except CompileError: body_node=body_parser.expr(0); inner_defs={}
   defs.update(inner_defs)
   defs[(name,len(params))]=(params,body_node)
  node=self.expr(0)
  if not self.peek('EOF'): raise CompileError('trailing syntax')
  if any(tok.k== 'VAR' for tok in self.t):
   bound={'__loc__'}
   def scan(x):
    if isinstance(x,list):
     for y in x: scan(y)
     return
    if not isinstance(x,tuple): return
    if x[0]=='var':
     if x[1] not in bound: raise CompileError('undefined binding')
    elif x[0]=='bin' and x[1]=='as':
     scan(x[2]); collect_pattern(x[3])
     return
    elif x[0]=='bin' and x[1]=='?//':
     collect_pattern(x[2]); collect_pattern(x[3])
     return
    for y in x[1:]: scan(y)
   def collect_pattern(p):
    if not isinstance(p,tuple): return
    if p[0]=='bin' and p[1] in ('as','?//'):
     collect_pattern(p[3]); collect_pattern(p[2]); return
    if p[0]=='pvar': bound.add(p[1])
    elif p[0] in ('parray',):
     for y in p[1]: collect_pattern(y)
    elif p[0]=='pobj':
     for _,y in p[1]: collect_pattern(y)
    elif p[0]=='pseq':
     for y in p[1]: collect_pattern(y)
   scan(node)
  return node,defs
 def _slice(self,a,b): return self.t[a:b]+[Tok('EOF','')]
 def expr(self,minp=0):
  x=self.atom()
  prec={'|':1,',':2,'as':3,'?//':3,'=':3,'|=':3,'//=':3,'+=':3,'-=':3,'*=':3,'/=':3,'%=':3,'//':4,'or':5,'and':6,'==':7,'!=':7,'<':7,'>':7,'<=':7,'>=':7,'+':8,'-':8,'*':9,'/':9,'%':9}
  while self.t[self.i].k in prec and prec[self.t[self.i].k]>=minp:
   op=self.pop().k; p=prec[op]
   y=self.pattern() if op in ('as','?//') else self.expr(p+(0 if op in ('|','//','=') else 1)); x=('bin',op,x,y)
  return x
 def pattern(self):
  if self.peek('VAR'):
   return ('pvar',self.pop().v)
  if self.peek('['):
   self.pop(); items=[]
   if self.peek(']'): raise CompileError('empty binding pattern')
   while not self.peek(']'):
    items.append(self.pattern())
    if self.peek(','): self.pop()
    else: break
   self.pop(']'); return ('parray',items)
  if self.peek('{'):
   self.pop(); items=[]
   if self.peek('}'): raise CompileError('empty binding pattern')
   while not self.peek('}'):
    if self.peek('('):
     self.pop(); keyexpr=self.expr(0); self.pop(')'); key=('exprkey',keyexpr)
    else: key=self.pop()
    if isinstance(key,tuple):
     if key[0]=='exprkey' and key[1][0] in ('lit','str') and not isinstance(key[1][1],str):
      raise CompileError('object key must be string')
     name=key
    elif key.k in ('ID','STR','VAR','as','def','if','then','else','elif','end','and','or','reduce','foreach','try','catch','label','break','import','include','module'):
     name=key.v
     if key.k=='VAR': name=name.split('::')[-1]
    else: raise CompileError('invalid binding pattern')
    if self.peek(':'):
     self.pop(); child=self.pattern()
     if isinstance(key,Tok) and key.k=='VAR': child=('pseq',[('pvar',name),child])
    else: child=('pvar',name)
    items.append((name,child))
    if self.peek(','): self.pop()
    else: break
   self.pop('}'); return ('pobj',items)
  raise CompileError('invalid binding pattern')
 def atom(self):
  t=self.pop()
  if t.k=='EOF': raise CompileError('unexpected eof')
  if t.k=='-': return ('neg',self.atom())
  if t.k=='.': x=('dot',)
  elif t.k=='NUM': x=('lit',float(t.v) if any(c in t.v for c in '.eE') else int(t.v))
  elif t.k=='STR': x=('str',t.v)
  elif t.k=='ID':
   if t.v in ('true','false','null'): x=('lit',{'true':True,'false':False,'null':None}[t.v])
   elif self.peek('('):
    self.pop(); args=[]
    if not self.peek(')'):
     while True:
      args.append(self.expr(0))
      if self.peek(';',','): self.pop(); continue
      break
    self.pop(')'); x=('call',t.v,args)
   else: x=('call',t.v,[])
  elif t.k=='VAR': x=('var',t.v)
  elif t.k=='FIELD': x=('field',t.v)
  elif t.k=='FORMAT':
   x=('format',t.v)
   if self.peek('STR'):
    x=('formatstr',t.v,self.pop().v)
  elif t.k=='try':
   body=self.expr(3)
   if self.peek('catch'):
    self.pop(); x=('catch',body,self.expr(0))
   else: x=('try',body)
  elif t.k=='if':
   cond=self.expr(0); self.pop('then'); yes=self.expr(0)
   if self.peek('else'):
    self.pop(); no=self.expr(0)
   else: no=('dot',)
   if self.peek('end'): self.pop()
   x=('if',cond,yes,no)
  elif t.k=='[':
   vals=[]
   if not self.peek(']'):
    while True:
     vals.append(self.expr(0))
     if self.peek(','): self.pop(); continue
     break
   self.pop(']'); x=('array',vals)
  elif t.k=='{':
   fields=[]
   if not self.peek('}'):
    while True:
     key=self.pop()
     if key.k in ('ID','as','def','if','then','else','elif','end','and','or','reduce','foreach','try','catch','label','break','import','include','module'):
      kn=('str',key.v)
     elif key.k=='STR': kn=('str',key.v)
     elif key.k=='VAR': kn=('var',key.v) if self.peek(':') else ('str',key.v.split('::')[-1])
     elif key.k=='(':
      kn=self.expr(0); self.pop(')')
     else: raise CompileError('invalid object key')
     if self.peek(':'):
      self.pop(); val=self.expr(3)
     else:
      if key.k=='ID': val=('field',key.v)
      elif key.k=='VAR': val=('var',key.v)
      else: val=('dynamic_field',kn)
     fields.append((kn,val))
     if self.peek(','): self.pop(); continue
     break
   self.pop('}'); x=('object',fields)
  elif t.k=='(':
   x=self.expr(0); self.pop(')')
  else: raise CompileError('unexpected token')
  while True:
   if self.peek('FIELD'): x=('pipe',x,('field',self.pop().v)); continue
   if self.peek('STR'): x=('pipe',x,('field',self.pop().v)); continue
   if self.peek('.') and self.i+1 < len(self.t) and self.t[self.i+1].k=='STR':
    self.pop(); x=('pipe',x,('field',self.pop().v)); continue
   if self.peek('['):
    self.pop();
    if self.peek(']'): self.pop(); x=('iter',x); continue
    if self.peek(':'):
     self.pop(); hi=None if self.peek(']') else self.expr(0); self.pop(']'); x=('slice',x,None,hi); continue
    key=self.expr(0)
    if self.peek(':'):
     self.pop(); hi=None if self.peek(']') else self.expr(0); self.pop(']'); x=('slice',x,key,hi); continue
    self.pop(']'); x=('index',x,key); continue
   if self.peek('?'): self.pop(); x=('try',x); continue
   break
  return x

def truth(v): return v is not None and v is not False
def compact(v): return json.dumps(v,ensure_ascii=False,separators=(',',':'),allow_nan=True)
def ev(n,v,env,defs):
 k=n[0]
 if k=='dot': return [v]
 if k=='lit': return [n[1]]
 if k=='str':
  return [interpolate(n[1],v,env,defs)]
 if k=='formatstr':
  kind, template=n[1],n[2]
  return [format_interpolated(kind,template,v,env,defs)]
 if k=='var': return [env.get(n[1],{'file':'<top-level>','line':1} if n[1]=='__loc__' else None)]
 if k=='object':
  out=[{}]
  for kn,vn in n[1]:
   nxt=[]
   for base in out:
    for key in ev(kn,v,env,defs):
     if not isinstance(key,str): raise RuntimeErrorJQ('object key must be string')
     for val in ev(vn,v,env,defs):
      z=dict(base); z[key]=val; nxt.append(z)
   out=nxt
  return out
 if k=='field': return [v.get(n[1]) if isinstance(v,dict) else None]
 if k=='dynamic_field':
  return [v.get(str(key)) if isinstance(v,dict) else None for key in ev(n[1],v,env,defs)]
 if k=='pipe':
  out=[]
  for a in ev(n[1],v,env,defs):
   try: out.extend(ev(n[2],a,env,defs))
   except RuntimeErrorJQ as ex:
    ex.partial=out + getattr(ex,'partial',[]); raise
  return out
 if k=='array': return [[z for a in [v] for q in n[1] for z in ev(q,a,env,defs)]]
 if k=='neg': return [-x for x in ev(n[1],v,env,defs)]
 if k=='iter':
  out=[]
  for base in ev(n[1],v,env,defs):
   if isinstance(base,dict): out.extend(base.values())
   elif isinstance(base,list): out.extend(base)
   else: raise RuntimeErrorJQ('cannot iterate')
  return out
 if k=='index':
  out=[]
  bases=ev(n[1],v,env,defs)
  if not bases: return []
  base=bases[0]
  for key in ev(n[2],v,env,defs):
   if isinstance(base,dict): out.append(base.get(str(key)))
   elif isinstance(base,list) and isinstance(key,(int,float)) and int(key)==key:
    ix=int(key); ix=ix if ix>=0 else len(base)+ix
    out.append(base[ix] if 0<=ix<len(base) else None)
   else: raise RuntimeErrorJQ('cannot index')
  return out
 if k=='slice':
  base=ev(n[1],v,env,defs); out=[]
  for item in base:
   lo=0 if n[2] is None else int(ev(n[2],item,env,defs)[0])
   hi=None if n[3] is None else int(ev(n[3],item,env,defs)[0])
   if isinstance(item,(list,str)): out.append(item[lo:hi])
   else: raise RuntimeErrorJQ('cannot slice')
  return out
 if k=='try':
  try:return ev(n[1],v,env,defs)
  except RuntimeErrorJQ as ex:return getattr(ex,'partial',[])
 if k=='catch':
  try:return ev(n[1],v,env,defs)
  except RuntimeErrorJQ as ex:return getattr(ex,'partial',[]) + ev(n[2],getattr(ex,'value',str(ex)),env,defs)
 if k=='if':
  out=[]
  for c in ev(n[1],v,env,defs):
   try: out.extend(ev(n[2] if truth(c) else n[3],v,env,defs))
   except RuntimeErrorJQ as ex:
    ex.partial=out; raise
  return out
 if k=='format': return [fmt(n[1],v)]
 if k=='call': return call(n[1],n[2],v,env,defs)
 if k=='bin': return binary(n[1],n[2],n[3],v,env,defs)
 raise RuntimeErrorJQ('unknown expression')

def interpolate(template,v,env,defs,transform=None):
 def sub(m):
  try:
   a=Parser(m.group(1)).expr(); vals=ev(a,v,env,defs)
   text=''.join(x if isinstance(x,str) else compact(x) for x in vals) if vals else ''
   return transform(text) if transform else text
  except Exception:
   return ''
 return re.sub(r'\\I(.*?)\\E',sub,template)

def bind(pattern,value,env):
 if pattern[0]=='pvar': env[pattern[1]]=value; return
 if pattern[0]=='pseq':
  for item in pattern[1]: bind(item,value,env)
  return
 if pattern[0]=='parray':
  if not isinstance(value,list): raise RuntimeErrorJQ('array pattern mismatch')
  for i,p in enumerate(pattern[1]): bind(p,value[i] if isinstance(value,list) and i<len(value) else None,env)
  return
 if pattern[0]=='pobj':
  if not isinstance(value,dict): raise RuntimeErrorJQ('object pattern mismatch')
  for key,p in pattern[1]:
   if isinstance(key,tuple):
    vals=ev(key[1],value,env,{})
    key=vals[0] if vals else None
   bind(p,value.get(key) if isinstance(value,dict) else None,env)
  return
 raise RuntimeErrorJQ('invalid binding')

def path_get(node, value, env, defs):
 if node[0]=='field': return [(node[1],)]
 if node[0]=='index':
  keys=ev(node[2],value,env,defs)
  return [('index',x) for x in keys]
 if node[0]=='slice': return [('slice',node[2],node[3])]
 if node[0]=='iter':
  if isinstance(value,list): return [('index',i) for i in range(len(value))]
  if isinstance(value,dict): return [('index',k) for k in value]
 return []

def selected_paths(node, value, env, defs, prefix=()):
 if node[0]=='dot': return [prefix]
 if node[0]=='field': return [prefix+(node[1],)]
 if node[0]=='pipe':
  # Path selectors are evaluated against the original value while retaining
  # the concrete paths selected by each component.
  if node[1][0]=='dot': return selected_paths(node[2],value,env,defs,prefix)
  bases=selected_paths(node[1],value,env,defs,prefix); out=[]
  for p in bases:
   cur=value
   for key in p:
    cur=cur.get(key) if isinstance(cur,dict) else cur[int(key)] if isinstance(cur,list) and -len(cur)<=int(key)<len(cur) else None
   out.extend(selected_paths(node[2],cur,env,defs,p))
  return out
 if node[0]=='index':
  bases=selected_paths(node[1],value,env,defs,prefix); out=[]
  for p in bases:
   cur=value
   for key in p: cur=cur.get(key) if isinstance(cur,dict) else cur[int(key)] if isinstance(cur,list) and -len(cur)<=int(key)<len(cur) else None
   for key in ev(node[2],cur,env,defs): out.append(p+(key,))
  return out
 if node[0]=='slice':
  bases=selected_paths(node[1],value,env,defs,prefix); out=[]
  for p in bases:
   cur=value
   for key in p: cur=cur.get(key) if isinstance(cur,dict) else cur[int(key)] if isinstance(cur,list) and -len(cur)<=int(key)<len(cur) else None
   lo=0 if node[2] is None else int(ev(node[2],cur,env,defs)[0]); hi=None if node[3] is None else int(ev(node[3],cur,env,defs)[0])
   out.append(('__slice__',p,lo,hi))
  return out
 if node[0]=='iter':
  bases=selected_paths(node[1],value,env,defs,prefix); out=[]
  for p in bases:
   cur=value
   for key in p: cur=cur.get(key) if isinstance(cur,dict) else cur[int(key)]
   if isinstance(cur,list): out.extend(p+(i,) for i in range(len(cur)))
   elif isinstance(cur,dict): out.extend(p+(key,) for key in cur)
  return out
 if node[0]=='call' and node[1]=='getpath' and node[2]:
  return [prefix+tuple(p) for p in ev(node[2][0],value,env,defs) if isinstance(p,list)]
 if node[0]=='call' and (node[1],len(node[2])) in defs:
  return selected_paths(defs[(node[1],len(node[2]))][1],value,env,defs,prefix)
 return []

def replace_path(value, path, new, delete=False):
 if not path:
  return None if delete else new
 out=json.loads(json.dumps(value, allow_nan=True))
 cur=out
 for idx,(kind,*rest) in enumerate(path[:-1]):
  key=rest[0]
  next_key=path[idx+1][1] if len(path[idx+1])>1 else None
  if kind=='index':
   if isinstance(cur,list):
    key=int(key)
    if key<0: key+=len(cur)
    while key>=len(cur): cur.append(None)
    if cur[key] is None: cur[key]=[] if isinstance(next_key,(int,float)) else {}
    cur=cur[key]
   else:
    if not isinstance(cur,dict): raise RuntimeErrorJQ('cannot index')
    cur=cur.setdefault(str(key), [] if isinstance(next_key,(int,float)) else {})
 last=path[-1]; kind=last[0]; key=last[1] if len(last)>1 else None
 if kind=='slice':
  lo=0 if key is None else int(ev(key,value,{},{} )[0]); hi=None if len(last)<3 or last[2] is None else int(ev(last[2],value,{},{} )[0])
  if delete: del cur[lo:hi]
  else: cur[lo:hi]=new
 elif isinstance(cur,list):
  key=int(key); key=key if key>=0 else len(cur)+key
  if delete: del cur[key]
  else:
   while key>=len(cur): cur.append(None)
   cur[key]=new
 elif isinstance(cur,dict):
  if delete: cur.pop(str(key),None)
  else: cur[str(key)]=new
 return out

def format_interpolated(kind,template,v,env,defs):
 # jq leaves literal text in a format-string untouched and formats only
 # interpolated values.
 return interpolate(template,v,env,defs,lambda x: fmt(kind,x))

def binary(op,a,b,v,e,d):
 if op==',': return ev(a,v,e,d)+ev(b,v,e,d)
 if op=='|':
  # Destructuring alternatives carry bindings into the following filter.
  # Evaluate each pattern against the same input and select the first one
  # whose shape matches.
  def alternatives(node):
   if node[0]=='bin' and node[1]=='?//':
    left=alternatives(node[2])
    return left+[(left[0][0],node[3])] if left else []
   if node[0]=='bin' and node[1]=='as': return [(node[2],node[3])]
