#!/usr/bin/env python3
"""Dependency-free jq front end and evaluator."""

from __future__ import annotations

import copy
import json
import math
import operator
import sys
from dataclasses import dataclass
from typing import Any, Callable, Iterator

from lexer import Lexer, LexerError, Token


class CompileError(Exception):
    pass


class RuntimeErrorJQ(Exception):
    def __init__(self, value: Any = "error") -> None:
        self.value = value
        super().__init__(str(value))


class BreakSignal(Exception):
    def __init__(self, label: str) -> None:
        self.label = label
        super().__init__(label)


class HaltSignal(Exception):
    pass


class HaltErrorSignal(Exception):
    def __init__(self, code: int) -> None:
        self.code = code
        super().__init__(str(code))


Env = dict[str, Any]
Node = Callable[[Any, Env], Iterator[Any]]
Matcher = Callable[[Any, Env], Env | None]
PATH_WILDCARD = object()


def path_spec(node: Node) -> list[Any] | None:
    """Return the statically known path represented by a parser node."""
    return getattr(node, "path_spec", None)


def mark_path(node: Node, spec: list[Any] | None) -> Node:
    setattr(node, "path_spec", spec)
    return node


def mark_pattern(node: Node, pattern: list[Any], predicate: Node | None = None) -> Node:
    setattr(node, "path_pattern", pattern)
    setattr(node, "path_predicate", predicate)
    return node


class FunctionDef:
    def __init__(self, name: str, parameters: list[tuple[str, bool]]) -> None:
        self.name = name
        self.parameters = parameters
        self.body: Node | None = None

    @property
    def arity(self) -> int:
        return len(self.parameters)


def one(value: Any) -> Iterator[Any]:
    yield value


def empty(_: Any, __: Env) -> Iterator[Any]:
    if False:
        yield None


def comma(left: Node, right: Node) -> Node:
    def evaluate(value: Any, env: Env) -> Iterator[Any]:
        yield from left(value, env)
        yield from right(value, env)
    return evaluate


def pipe(left: Node, right: Node) -> Node:
    def evaluate(value: Any, env: Env) -> Iterator[Any]:
        for item in left(value, env):
            yield from right(item, env)
    return evaluate


def truth(value: Any) -> bool:
    return value is not None and value is not False


def json_value(text: str) -> Any:
    try:
        return json.loads(text)
    except json.JSONDecodeError as error:
        raise CompileError(f"invalid literal: {text}") from error


def binary(left: Node, right: Node, fn: Callable[[Any, Any], Any]) -> Node:
    def evaluate(value: Any, env: Env) -> Iterator[Any]:
        left_values = list(left(value, env))
        right_values = list(right(value, env))
        for lhs in left_values:
            for rhs in right_values:
                try:
                    yield fn(lhs, rhs)
                except (TypeError, ValueError, ZeroDivisionError, OverflowError) as error:
                    raise RuntimeErrorJQ(str(error)) from error
    return evaluate


def plus(lhs: Any, rhs: Any) -> Any:
    if lhs is None:
        return copy.deepcopy(rhs)
    if rhs is None:
        return copy.deepcopy(lhs)
    if is_number(lhs) and is_number(rhs):
        return lhs + rhs
    if isinstance(lhs, str) and isinstance(rhs, str):
        return lhs + rhs
    if isinstance(lhs, list) and isinstance(rhs, list):
        return copy.deepcopy(lhs) + copy.deepcopy(rhs)
    if isinstance(lhs, dict) and isinstance(rhs, dict):
        result = copy.deepcopy(lhs)
        result.update(copy.deepcopy(rhs))
        return result
    raise TypeError("cannot add values")


def is_number(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def subtract(lhs: Any, rhs: Any) -> Any:
    if is_number(lhs) and is_number(rhs):
        return lhs - rhs
    if isinstance(lhs, list) and isinstance(rhs, list):
        return [item for item in lhs if item not in rhs]
    raise TypeError("cannot subtract values")


def multiply(lhs: Any, rhs: Any) -> Any:
    if is_number(lhs) and is_number(rhs):
        return lhs * rhs
    if isinstance(lhs, str) and is_number(rhs):
        count = int(rhs)
        if count < 0 or count != rhs:
            raise TypeError("cannot multiply string by non-integer")
        return lhs * count
    if isinstance(rhs, str) and is_number(lhs):
        count = int(lhs)
        if count < 0 or count != lhs:
            raise TypeError("cannot multiply string by non-integer")
        return rhs * count
    raise TypeError("cannot multiply values")


def divide(lhs: Any, rhs: Any) -> Any:
    if is_number(lhs) and is_number(rhs):
        if rhs == 0:
            raise ZeroDivisionError("cannot divide by zero")
        return lhs / rhs
    if isinstance(lhs, str) and isinstance(rhs, str):
        return lhs.split(rhs) if rhs else list(lhs)
    raise TypeError("cannot divide values")


def remainder(lhs: Any, rhs: Any) -> Any:
    if not is_number(lhs) or not is_number(rhs):
        raise TypeError("cannot calculate remainder")
    if rhs == 0:
        raise ZeroDivisionError("cannot divide by zero")
    return math.fmod(lhs, rhs)


def jq_equal(lhs: Any, rhs: Any) -> bool:
    if is_number(lhs) and is_number(rhs):
        return lhs == rhs
    if type(lhs) is not type(rhs):
        return False
    if isinstance(lhs, dict):
        return lhs.keys() == rhs.keys() and all(jq_equal(lhs[key], rhs[key]) for key in lhs)
    if isinstance(lhs, list):
        return len(lhs) == len(rhs) and all(jq_equal(a, b) for a, b in zip(lhs, rhs))
    return lhs == rhs


def compare_key(value: Any) -> tuple[int, Any]:
    if value is None: return (0, 0)
    if value is False: return (1, 0)
    if value is True: return (2, 0)
    if is_number(value): return (3, value)
    if isinstance(value, str): return (4, value)
    if isinstance(value, list): return (5, tuple(compare_key(item) for item in value))
    return (6, tuple((key, compare_key(value[key])) for key in sorted(value)))


class Parser:
    def __init__(self, source: str) -> None:
        try:
            self.tokens = Lexer(source).tokenize()
        except LexerError as error:
            raise CompileError(str(error)) from error
        self.position = 0
        # Bindings and labels are lexical compile-time names.  Keeping these
        # sets on the parser prevents an unresolved name from degrading into
        # a runtime null value.
        self.bindings: set[str] = set()
        self.labels: set[str] = set()
        self.functions: dict[tuple[str, int], FunctionDef] = {}
        self.filter_parameters: set[str] = set()

    def peek(self, kind: str | None = None) -> Token | None:
        token = self.tokens[self.position] if self.position < len(self.tokens) else None
        return token if kind is None or (token is not None and token.kind == kind) else None

    def take(self, kind: str | None = None) -> Token:
        token = self.peek(kind)
        if token is None:
            actual = self.peek().kind if self.peek() else "end of input"
            raise CompileError(f"expected {kind or 'token'}, got {actual}")
        self.position += 1
        return token

    def parse(self) -> Node:
        node = self.query()
        if self.peek() is not None:
            raise CompileError(f"unexpected {self.peek().text}")
        return node

    def query(self, stop_comma: bool = False) -> Node:
        # jq definitions are declarations in the surrounding lexical scope.
        # A declaration's body ends at its semicolon, so the ordinary query
        # parser naturally leaves the following expression for this loop.
        while self.peek("DEF"):
            self.parse_function_definition()
            self.take(";")
        if self.peek("LABEL"):
            self.take()
            label = self.take("BINDING").text
            self.take("|")
            previous_labels = self.labels
            self.labels = previous_labels | {label}
            try:
                node = self.query(stop_comma)
            finally:
                self.labels = previous_labels
            def labeled(value: Any, env: Env, node: Node = node, label: str = label) -> Iterator[Any]:
                try:
                    yield from node(value, env)
                except BreakSignal as signal:
                    if signal.label != label:
                        raise
            return labeled
        node = self.expression(2 if stop_comma else 0)
        if not stop_comma and self.peek("AS"):
            node = self.bind(node)
        while self.peek("|"):
            self.take()
            right = self.expression(2 if stop_comma else 0)
            if not stop_comma and self.peek("AS"):
                right = self.bind(right)
            left = node
            node = pipe(left, right)
            left_pattern = getattr(left, "path_pattern", None)
            if path_spec(left) is not None and getattr(right, "path_predicate", None) is not None:
                mark_pattern(node, path_spec(left) + [PATH_WILDCARD], getattr(right, "path_predicate"))
            elif left_pattern is not None and getattr(right, "path_predicate", None) is not None:
                mark_pattern(node, left_pattern, getattr(right, "path_predicate"))
        return node

    def parse_function_definition(self) -> None:
        self.take("DEF")
        name = self.take("IDENT").text
        parameters: list[tuple[str, bool]] = []
        if self.peek("("):
            self.take()
            if not self.peek(")"):
                while True:
                    if self.peek("BINDING"):
                        parameters.append((self.take().text, True))
                    else:
                        parameters.append((self.take("IDENT").text, False))
                    if not self.peek(";"):
                        break
                    self.take()
            self.take(")")
        self.take(":")
        definition = FunctionDef(name, parameters)
        # Install a placeholder first: recursive references in the body must
        # resolve to this definition, while later redefinitions get a new
        # object and do not rewrite already compiled calls.
        self.functions[(name, len(parameters))] = definition
        previous_bindings = self.bindings
        previous_filter_parameters = self.filter_parameters
        self.bindings = set(previous_bindings)
        self.filter_parameters = set(previous_filter_parameters)
        for parameter, is_value in parameters:
            if is_value:
                self.bindings.add(parameter)
            else:
                self.filter_parameters.add(parameter)
        try:
            definition.body = self.query()
        finally:
            self.bindings = previous_bindings
            self.filter_parameters = previous_filter_parameters
            # Nested definitions are local to this function body.  Restore
            # the enclosing definition for calls compiled after the body.
            self.functions[(name, len(parameters))] = definition

    def bind(self, source: Node) -> Node:
        self.take("AS")
        patterns: list[tuple[Matcher, set[str]]] = [self.pattern()]
        while self.peek("?//"):
            self.take()
            patterns.append(self.pattern())
        self.take("|")
        previous_bindings = self.bindings
        visible = set(previous_bindings)
        for _, names in patterns:
            visible.update(names)
        self.bindings = visible
        try:
            continuation = self.query()
        finally:
            self.bindings = previous_bindings

        def bound(value: Any, env: Env, source: Node = source,
                  continuation: Node = continuation,
                  patterns: list[tuple[Matcher, set[str]]] = patterns) -> Iterator[Any]:
            for item in source(value, env):
                for index, (matcher, _) in enumerate(patterns):
                    try:
                        matched = matcher(item, env)
                    except RuntimeErrorJQ:
                        if index + 1 == len(patterns):
                            raise
                        continue
                    if matched is None:
                        continue
                    scoped = dict(env)
                    scoped.update(matched)
                    try:
                        yield from continuation(value, scoped)
                    except RuntimeErrorJQ:
                        if index + 1 == len(patterns):
                            raise
                        continue
                    break
        return bound

    def pattern(self) -> tuple[Matcher, set[str]]:
        if self.peek("BINDING"):
            name = self.take().text
            return self.binding_pattern(name), {name}
        if self.peek("["):
            self.take()
            if self.peek("]"):
                raise CompileError("empty array pattern")
            parts = [self.pattern()]
            while self.peek(","):
                self.take()
                parts.append(self.pattern())
            self.take("]")
            names = set().union(*(part[1] for part in parts))

            def match(value: Any, env: Env, parts: list[tuple[Matcher, set[str]]] = parts) -> Env | None:
                if not isinstance(value, list):
                    raise RuntimeErrorJQ("cannot destructure non-array")
                result: Env = {}
                for index, (matcher, _) in enumerate(parts):
                    child = matcher(value[index] if index < len(value) else None, env)
                    if child is None:
                        return None
                    result.update(child)
                return result
            return match, names
        if self.peek("{"):
            self.take()
            entries: list[tuple[str, Matcher, set[str]]] = []
            while not self.peek("}"):
                if self.peek("BINDING"):
                    token = self.take().text
                    key = token
                    if self.peek(":"):
                        self.take()
                        child, names = self.pattern()
                    else:
                        child, names = self.binding_pattern(token), {token}
                else:
                    key_token = self.peek()
                    if key_token is None or key_token.kind not in {"IDENT", "FIELD", "AS", "DEF", "MODULE", "IMPORT", "INCLUDE", "IF", "THEN", "ELSE", "ELIF", "REDUCE", "FOREACH", "END", "AND", "OR", "TRY", "CATCH", "LABEL", "BREAK", "QQSTRING_START"}:
                        raise CompileError("invalid object pattern")
                    if key_token.kind == "QQSTRING_START":
                        key_values = list(self.string()(None, {}))
                        if len(key_values) != 1 or not isinstance(key_values[0], str):
                            raise CompileError("object pattern key must be a string")
                        key = key_values[0]
                    else:
                        key = self.take().text
                    self.take(":")
                    child, names = self.pattern()
                entries.append((key, child, names))
                if not self.peek(","):
                    break
                self.take()
            self.take("}")
            names = set().union(*(entry[2] for entry in entries)) if entries else set()

            def match(value: Any, env: Env, entries: list[tuple[str, Matcher, set[str]]] = entries) -> Env | None:
                if not isinstance(value, dict):
                    raise RuntimeErrorJQ("cannot destructure non-object")
                result: Env = {}
                for key, matcher, _ in entries:
                    child = matcher(value.get(key), env)
                    if child is None:
                        return None
                    result.update(child)
                return result
            return match, names
        raise CompileError("expected binding pattern")

    @staticmethod
    def binding_pattern(name: str) -> Matcher:
        return lambda value, env, name=name: {name: value}

    def expression(self, minimum: int = 0) -> Node:
        node = self.term()
        precedence = {",": 1, "//": 2, "OR": 3, "AND": 4, "==": 5, "!=": 5,
                      "<": 5, ">": 5, "<=": 5, ">=": 5, "+": 6, "-": 6,
                      "*": 7, "/": 7, "%": 7}
        while self.peek() and self.peek().kind in precedence and precedence[self.peek().kind] >= minimum:
            op = self.take().kind
            right = self.expression(precedence[op] + 1)
            if op == ",":
                node = comma(node, right)
            elif op == "//":
                left = node
                def defined(value: Any, env: Env, left: Node = left, right: Node = right) -> Iterator[Any]:
                    values = [item for item in left(value, env) if truth(item)]
                    yield from (values if values else right(value, env))
                node = defined
            elif op in ("AND", "OR"):
                node = binary(node, right, lambda a, b, op=op: truth(a) and truth(b) if op == "AND" else truth(a) or truth(b))
            elif op == "+": node = binary(node, right, plus)
            elif op == "-": node = binary(node, right, subtract)
            elif op == "*": node = binary(node, right, multiply)
            elif op == "/": node = binary(node, right, divide)
            elif op == "%": node = binary(node, right, remainder)
            elif op == "==": node = binary(node, right, jq_equal)
            elif op == "!=": node = binary(node, right, lambda a, b: not jq_equal(a, b))
            elif op == "<": node = binary(node, right, lambda a, b: compare_key(a) < compare_key(b))
            elif op == ">": node = binary(node, right, lambda a, b: compare_key(a) > compare_key(b))
            elif op == "<=": node = binary(node, right, lambda a, b: compare_key(a) <= compare_key(b))
            elif op == ">=": node = binary(node, right, lambda a, b: compare_key(a) >= compare_key(b))
        return node

    def term(self) -> Node:
        if self.peek("REDUCE") or self.peek("FOREACH"):
            return self.accumulation()
        if self.peek("-"):
            self.take(); operand = self.term()
            def negate(value: Any, env: Env) -> Iterator[Any]:
                for item in operand(value, env):
                    if not is_number(item):
                        raise RuntimeErrorJQ("cannot negate value")
                    yield -item
            return negate
        if self.peek("("):
            self.take(); node = self.query(); self.take(")"); return self.postfix(node)
        if self.peek("."):
            self.take(); node: Node = mark_path(lambda value, env: one(value), [])
        elif self.peek(".."):
            self.take()
            node = self.recursive_node(None, None)
        elif self.peek("FIELD"):
            key = self.take().text
            node = mark_path(lambda value, env, key=key: one(self.index_value(value, key)), [key])
        elif self.peek("BINDING"):
            name = self.take().text
            if name != "__loc__" and name not in self.bindings:
                raise CompileError(f"undefined binding ${name}")
            node = lambda value, env, name=name: one(env.get(name))
        elif self.peek("LITERAL"):
            literal = json_value(self.take().text); node = lambda value, env, literal=literal: one(literal)
        elif self.peek("QQSTRING_START"):
            node = self.string()
        elif self.peek("["):
            self.take()
            if self.peek("]"):
                self.take(); node = lambda value, env: one([])
            else:
                inner = self.query(); self.take("]")
                node = lambda value, env, inner=inner: one(list(inner(value, env)))
        elif self.peek("{"):
            node = self.object()
        elif self.peek("IF"):
            node = self.conditional()
        elif self.peek("TRY"):
            node = self.try_expression()
        elif self.peek("BREAK"):
            self.take()
            label = self.take("BINDING").text
            if label not in self.labels:
                raise CompileError(f"undefined label ${label}")
            node = lambda value, env, label=label: (_ for _ in ()).throw(BreakSignal(label))
        elif self.peek("IDENT"):
            name = self.take().text
            if name in ("true", "false", "null"):
                constant = {"true": True, "false": False, "null": None}[name]
                node = lambda value, env, constant=constant: one(constant)
            else:
                if name in self.filter_parameters and self.peek("(") is None:
                    node = self.filter_call(name)
                elif self.peek("(") is None and (name, 0) not in self.functions and name not in {"empty", "error", "halt", "halt_error", "length", "type", "not", "keys", "add", "map", "first", "last", "nth", "range", "recurse", "paths", "path", "getpath"}:
                    raise CompileError(f"unknown function {name}")
                elif (name, 0) in self.functions and self.peek("(") is None:
                    node = self.function_call(self.functions[(name, 0)], [])
                else:
                    node = self.call(name)
        else:
            raise CompileError("expected expression")
        return self.postfix(node)

    def accumulation(self) -> Node:
        kind = self.take().kind
        source = self.expression()
        self.take("AS")
        matcher, names = self.pattern()
        self.take("(")
        previous_bindings = self.bindings
        self.bindings = previous_bindings | names
        try:
            initial = self.query()
            self.take(";")
            update = self.query()
            extract: Node | None = None
            if kind == "FOREACH" and self.peek(";"):
                self.take()
                extract = self.query()
        finally:
            self.bindings = previous_bindings
        self.take(")")

        def evaluate(value: Any, env: Env) -> Iterator[Any]:
            items = list(source(value, env))
            for initial_state in initial(value, env):
                states = [initial_state]
                for item in items:
                    matched = matcher(item, env)
                    if matched is None:
                        continue
                    scoped = dict(env)
                    scoped.update(matched)
                    next_states: list[Any] = []
                    for state in states:
                        next_states.extend(update(state, scoped))
                    states = next_states
                    if kind == "FOREACH":
                        if extract is None:
                            yield from states
                        else:
                            for state in states:
                                yield from extract(state, scoped)
                if kind == "REDUCE":
                    yield from states
        return evaluate

    def postfix(self, node: Node) -> Node:
        while self.peek("FIELD") or self.peek("[") or self.peek("?"):
            if self.peek("FIELD"):
                key = self.take().text
                previous = node
                spec = path_spec(previous)
                node = mark_path(
                    lambda value, env, previous=previous, key=key: (self.index_value(item, key) for item in previous(value, env)),
                    None if spec is None else spec + [key],
                )
            elif self.peek("?"):
                self.take(); previous = node
                node = self.optional(previous)
            else:
                self.take()
                if self.peek("]"):
                    self.take(); previous = node
                    node = mark_path(
                        lambda value, env, previous=previous: (item for base in previous(value, env) for item in self.iterate_value(base)),
                        None,
                    )
                    if path_spec(previous) is not None:
                        mark_pattern(node, path_spec(previous) + [PATH_WILDCARD])
                else:
                    start = self.expression(2) if not self.peek(":") else None
                    index_nodes = [] if start is None else [start]
                    while self.peek(","):
                        self.take()
                        next_start = self.expression(2)
                        index_nodes.append(next_start)
                        start = comma(start, next_start)
                    if self.peek(":"):
                        self.take(); end = self.expression(2) if not self.peek("]") else None
                        self.take("]"); previous = node
                        node = lambda value, env, previous=previous, start=start, end=end: (
                            self.slice_value(base, start(base, env) if start else [None], end(base, env) if end else [None])
                            for base in previous(value, env)
                        )
                    else:
                        self.take("]"); previous = node
                        spec = path_spec(previous)
                        constant_index: Any = None
                        if start is not None and path_spec(start) is None:
                            try:
                                values = list(start(None, {}))
                                if len(values) == 1 and isinstance(values[0], (str, int, float)) and not isinstance(values[0], bool):
                                    constant_index = values[0]
                            except (RuntimeErrorJQ, TypeError, ValueError):
                                pass
                        node = mark_path(lambda value, env, previous=previous, start=start: (
                            self.index_value(base, key)
                            for base in previous(value, env)
                            for key in start(base, env)
                        ), None if spec is None or constant_index is None else spec + [constant_index])
                        if spec is not None and len(index_nodes) > 1:
                            constants: list[Any] = []
                            for index_node in index_nodes:
                                try:
                                    values = list(index_node(None, {}))
                                except RuntimeErrorJQ:
                                    values = []
                                if len(values) != 1 or not isinstance(values[0], (str, int, float)) or isinstance(values[0], bool):
                                    constants = []
                                    break
                                constants.append(values[0])
                            if constants:
                                setattr(node, "path_alternatives", [spec + [item] for item in constants])
        return node

    @staticmethod
    def optional(previous: Node) -> Node:
        def evaluate(value: Any, env: Env) -> Iterator[Any]:
            try:
                yield from previous(value, env)
            except RuntimeErrorJQ:
                return
        return evaluate

    @staticmethod
    def iterate_value(base: Any) -> Iterator[Any]:
        if isinstance(base, dict):
            yield from base.values()
            return
        if isinstance(base, list):
            yield from base
            return
        raise RuntimeErrorJQ("cannot iterate over value")

    @staticmethod
    def index_value(base: Any, key: Any) -> Any:
        if base is None:
            return None
        if isinstance(base, dict):
            if not isinstance(key, str):
                raise RuntimeErrorJQ("cannot index object with non-string key")
            return base.get(key)
        if isinstance(base, (list, str)) and isinstance(key, (int, float)) and not isinstance(key, bool):
            try:
                index = int(key)
            except (OverflowError, ValueError):
                return None
            return base[index] if -len(base) <= index < len(base) else None
        raise RuntimeErrorJQ("cannot index value")

    @staticmethod
    def slice_value(base: Any, starts: list[Any], ends: list[Any]) -> Any:
        start = next(iter(starts), None)
        end = next(iter(ends), None)
        start_i = None if start is None else int(start)
        end_i = None if end is None else int(end)
        if isinstance(base, (list, str)):
            return base[slice(start_i, end_i)]
        if base is None:
            return None
        raise RuntimeErrorJQ("cannot slice value")

    def string(self) -> Node:
        self.take("QQSTRING_START"); parts: list[Node] = []
        while not self.peek("QQSTRING_END"):
            if self.peek("QQSTRING_TEXT"):
                text = json_value('"' + self.take().text + '"')
                if text.strip() == "" and parts and self.peek("QQSTRING_END"):
                    continue
                parts.append(lambda value, env, text=text: one(text))
            elif self.peek("QQSTRING_INTERP_START"):
                self.take(); parts.append(self.query()); self.take("QQSTRING_INTERP_END")
            else: raise CompileError("unterminated string")
        self.take("QQSTRING_END")
        def render(value: Any, env: Env) -> Iterator[Any]:
            streams = [list(part(value, env)) for part in parts]
            if not streams: yield ""; return
            result = [""]
            for stream in streams:
                result = [prefix + (item if isinstance(item, str) else json.dumps(item, separators=(",", ":"))) for prefix in result for item in stream]
            yield from result
        return render

    def object(self) -> Node:
        self.take("{"); entries: list[tuple[Node, Node]] = []
        keyword_keys = {
            "AS", "DEF", "MODULE", "IMPORT", "INCLUDE", "IF", "THEN",
            "ELSE", "ELIF", "REDUCE", "FOREACH", "END", "AND", "OR",
            "TRY", "CATCH", "LABEL", "BREAK",
        }
        while not self.peek("}"):
            if self.peek("IDENT") or self.peek("FIELD") or (self.peek() and self.peek().kind in keyword_keys):
                key = self.take().text
                if self.peek(":"):
                    self.take(); value = self.query(stop_comma=True)
                else:
                    value = lambda item, env, key=key: one(item.get(key) if isinstance(item, dict) else None)
                key_node: Node = lambda item, env, key=key: one(key)
            elif self.peek("BINDING"):
                binding = self.take().text
                if self.peek(":"):
                    self.take(); value = self.query(stop_comma=True)
                    key_node = lambda item, env, binding=binding: one(env.get(binding))
                else:
                    value = lambda item, env, binding=binding: one(env.get(binding))
                    key_node = lambda item, env, binding=binding: one(binding)
            elif self.peek("("):
                self.take()
                constant_key = self.peek("LITERAL") is not None or self.peek("QQSTRING_START") is not None
                if self.peek("IDENT") and self.peek().text in {"true", "false", "null"}:
                    constant_key = True
                key_node = self.query()
                self.take(")")
                if not self.peek(":"):
                    raise CompileError("object key requires value")
                self.take()
                value = self.query(stop_comma=True)
                # A literal non-string key is a compile-time error. Dynamic
                # keys are checked when their generator produces a value.
                if constant_key:
                    try:
                        constant_keys = list(key_node(None, {}))
                    except RuntimeErrorJQ:
                        constant_keys = []
                    if constant_keys and all(not isinstance(key, str) for key in constant_keys):
                        raise CompileError("object key must be a string")
            elif self.peek("QQSTRING_START"):
                key_node = self.string()
                key_values = list(key_node(None, {}))
                if len(key_values) != 1 or not isinstance(key_values[0], str):
                    raise CompileError("object key must be a string")
                key = key_values[0]
                if not self.peek(":"): raise CompileError("object key requires value")
                self.take(); value = self.query(stop_comma=True)
            else:
                raise CompileError("invalid object key")
            entries.append((key_node, value))
            if not self.peek(","): break
            self.take()
        self.take("}")
        def build(value: Any, env: Env) -> Iterator[Any]:
            partials: list[dict[str, Any]] = [{}]
            for key_expression, value_expression in entries:
                next_partials: list[dict[str, Any]] = []
                keys = list(key_expression(value, env))
                values = list(value_expression(value, env))
                for partial in partials:
                    for key in keys:
                        if not isinstance(key, str):
                            raise RuntimeErrorJQ("object key must be a string")
                        for item in values:
                            expanded = dict(partial)
                            expanded[key] = item
                            next_partials.append(expanded)
                partials = next_partials
            yield from partials
        return build

    def conditional(self) -> Node:
        self.take("IF"); condition = self.query(); self.take("THEN"); yes = self.query()
        no: Node = lambda value, env: one(value)
        if self.peek("ELIF"):
            self.take()
            elif_condition = self.query()
            self.take("THEN")
            elif_yes = self.query()
            elif_no: Node = lambda value, env: one(value)
            if self.peek("ELIF"):
                # Parse the remaining chain using the same conditional
                # grammar, with a synthetic leading branch avoided by a
                # small recursive helper.
                elif_no = self.conditional_tail()
            elif self.peek("ELSE"):
                self.take(); elif_no = self.query()
            no = lambda value, env, c=elif_condition, y=elif_yes, n=elif_no: (
                out for test in c(value, env) for out in ((y if truth(test) else n)(value, env))
            )
        elif self.peek("ELSE"):
            self.take(); no = self.query()
        self.take("END")
        return lambda value, env: (out for test in condition(value, env) for out in ((yes if truth(test) else no)(value, env)))

    def conditional_tail(self) -> Node:
        self.take("ELIF")
        condition = self.query(); self.take("THEN"); yes = self.query()
        no: Node = lambda value, env: one(value)
        if self.peek("ELIF"):
            no = self.conditional_tail()
        elif self.peek("ELSE"):
            self.take(); no = self.query()
        return lambda value, env, c=condition, y=yes, n=no: (
            out for test in c(value, env) for out in ((y if truth(test) else n)(value, env))
        )

    def try_expression(self) -> Node:
        self.take("TRY")
        # try has term-level precedence: `try EXP | next` catches EXP,
        # while `try EXP catch handler` supplies the exception continuation.
        if self.peek("IF"):
            attempted = self.conditional()
        else:
            attempted = self.expression(8)
        handler: Node = empty
        if self.peek("CATCH"):
            self.take()
            handler = self.expression(8)

        def evaluate(value: Any, env: Env) -> Iterator[Any]:
            try:
                yield from attempted(value, env)
            except BreakSignal:
                raise
            except RuntimeErrorJQ as error:
                yield from handler(error.value, env)
        return evaluate

    @staticmethod
    def product(groups: list[list[Any]]) -> Iterator[tuple[Any, ...]]:
        if not groups:
            yield ()
            return
        for head in groups[0]:
            for tail in Parser.product(groups[1:]):
                yield (head, *tail)

    @staticmethod
    def iteration_node(kind: str, condition: Node, update: Node) -> Node:
        def evaluate(value: Any, env: Env) -> Iterator[Any]:
            tests = list(condition(value, env))
            if kind == "while":
                if any(truth(test) for test in tests):
                    yield value
                    for advanced in update(value, env):
                        yield from Parser.iteration_node(kind, condition, update)(advanced, env)
            elif any(truth(test) for test in tests):
                yield value
            else:
                for advanced in update(value, env):
                    yield from Parser.iteration_node(kind, condition, update)(advanced, env)
        return evaluate

    @staticmethod
    def repeat_node(expression: Node) -> Node:
        def evaluate(value: Any, env: Env) -> Iterator[Any]:
            current = value
            while True:
                outputs = list(expression(current, env))
                if not outputs:
                    return
                for output in outputs:
                    yield output
                    current = output
        return evaluate

    @staticmethod
    def recursive_node(step: Node | None, condition: Node | None) -> Node:
        def evaluate(value: Any, env: Env) -> Iterator[Any]:
            yield value
            next_step = step
            if next_step is None:
                def default_step(item: Any, scope: Env) -> Iterator[Any]:
                    try:
                        yield from Parser.iterate_value(item)
                    except RuntimeErrorJQ:
                        return
                next_step = default_step
            for child in next_step(value, env):
                if condition is not None and not any(truth(test) for test in condition(child, env)):
                    continue
                yield from evaluate(child, env)
        return evaluate

    def call(self, name: str) -> Node:
        args: list[Node] = []
        if self.peek("("):
            self.take()
            if not self.peek(")"):
                while True:
                    args.append(self.query())
                    if not self.peek(";"): break
                    self.take()
            self.take(")")
        function = self.functions.get((name, len(args)))
        if function is not None:
            return self.function_call(function, args)
        builtins = {"empty", "error", "halt", "halt_error", "length", "type", "not", "keys", "add", "map",
                    "reduce", "foreach", "range", "while", "until", "repeat", "limit", "skip",
                    "first", "last", "nth", "recurse", "path", "paths", "getpath", "select"}
        if name not in builtins:
            raise CompileError(f"unknown function {name}/{len(args)}")
        def invoke(value: Any, env: Env) -> Iterator[Any]:
            if name == "empty":
                yield from empty(value, env)
                return
            if name == "select":
                if len(args) != 1:
                    raise RuntimeErrorJQ("select expects one argument")
                for test in args[0](value, env):
                    if truth(test):
                        yield value
                return
            if name == "path":
                if len(args) != 1:
                    raise RuntimeErrorJQ("path expects one argument")
                spec = path_spec(args[0])
                alternatives = getattr(args[0], "path_alternatives", None)
                if alternatives is not None:
                    yield from alternatives
                    return
                pattern = getattr(args[0], "path_pattern", None)
                if pattern is not None:
                    predicate = getattr(args[0], "path_predicate", None)
                    for candidate, item in self.discovered_paths(value):
                        if len(candidate) == len(pattern) and all(expected is PATH_WILDCARD or expected == actual for expected, actual in zip(pattern, candidate)) and (predicate is None or any(truth(test) for test in predicate(item, env))):
                            yield candidate
                    return
                if spec is None:
                    raise RuntimeErrorJQ("Invalid path expression")
                yield spec
                return
            if name == "paths":
                if len(args) > 1:
                    raise RuntimeErrorJQ("paths expects zero or one arguments")
                predicate = args[0] if args else None
                for path, item in self.discovered_paths(value):
                    if predicate is None or any(truth(test) for test in predicate(item, env)):
                        yield path
                return
            if name == "getpath":
                if not args:
                    raise RuntimeErrorJQ("getpath expects a path")
                for argument in args:
                    for path in argument(value, env):
                        if not isinstance(path, list):
                            raise RuntimeErrorJQ("path must be an array")
                        yield self.read_path(value, path)
                return
            if name == "error":
                if args:
                    for message in args[0](value, env):
                        raise RuntimeErrorJQ(message)
                raise RuntimeErrorJQ(value)
            if name == "halt":
                raise HaltSignal()
            if name == "halt_error":
                code = 5
                if args:
                    code = int(next(iter(args[0](value, env))))
                raise HaltErrorSignal(code)
            if name == "length": yield len(value) if value is not None else 0; return
            if name == "type": yield "null" if value is None else "boolean" if isinstance(value, bool) else "number" if isinstance(value, (int, float)) else "string" if isinstance(value, str) else "array" if isinstance(value, list) else "object"; return
            if name == "not": yield not truth(value); return
            if name == "keys": yield sorted(value) if isinstance(value, dict) else list(range(len(value))); return
            if name == "add":
                result = None
                for item in value: result = plus(result, item)
                yield result; return
            if name == "map" and args:
                yield [item for element in value for item in args[0](element, env)]; return
            if name == "range":
                if len(args) not in (1, 2, 3):
                    raise RuntimeErrorJQ("range expects one, two, or three arguments")
                argument_values = [list(argument(value, env)) for argument in args]
                for choices in self.product(argument_values):
                    if len(choices) == 1:
                        start, stop, step = 0, choices[0], 1
                    elif len(choices) == 2:
                        start, stop, step = choices[0], choices[1], 1
                    else:
                        start, stop, step = choices
                    if step == 0:
                        continue
                    current = start
                    while (step > 0 and current < stop) or (step < 0 and current > stop):
                        yield current
                        current += step
                return
            if name in {"while", "until", "repeat"}:
                if name == "repeat":
                    if len(args) != 1: raise RuntimeErrorJQ("repeat expects one argument")
                    yield from self.repeat_node(args[0])(value, env)
                    return
                if len(args) != 2: raise RuntimeErrorJQ(f"{name} expects two arguments")
                node = self.iteration_node(name, args[0], args[1])
                yield from node(value, env)
                return
            if name in {"limit", "skip"}:
                if len(args) != 2: raise RuntimeErrorJQ(f"{name} expects two arguments")
                counts = list(args[0](value, env))
                for count in counts:
                    if not is_number(count) or count < 0:
                        raise RuntimeErrorJQ(f"{name} doesn't support negative count")
                    seen = 0
                    for item in args[1](value, env):
                        if name == "limit" and seen >= count: break
                        if name == "limit" or (name == "skip" and seen >= count): yield item
                        seen += 1
                    if name == "limit" and count == 0:
                        continue
                return
            if name in {"first", "last", "nth"} and args:
                if name == "nth":
                    if len(args) != 2: raise RuntimeErrorJQ("nth expects an index and a generator")
                    indexes = list(args[0](value, env))
                    for index in indexes:
                        if index < 0: raise RuntimeErrorJQ("nth doesn't support negative indices")
                        for position, item in enumerate(args[1](value, env)):
                            if position == index:
                                yield item
                                break
                    return
                if len(args) != 1: raise RuntimeErrorJQ(f"{name} expects one generator")
                items = list(args[0](value, env))
                if items: yield items[0] if name == "first" else items[-1]
                return
            if name == "recurse":
                if len(args) == 0:
                    yield from self.recursive_node(None, None)(value, env)
                elif len(args) == 1:
                    yield from self.recursive_node(args[0], None)(value, env)
                elif len(args) == 2:
                    yield from self.recursive_node(args[0], args[1])(value, env)
                else:
                    raise RuntimeErrorJQ("recurse expects zero, one, or two arguments")
                return
            if name in {"first", "last"} and not args:
                if isinstance(value, list) and value:
                    yield value[0] if name == "first" else value[-1]
                return
            if name == "nth" and not args:
                if isinstance(value, list):
                    yield value[0] if value else None
                return
            raise RuntimeErrorJQ(f"unknown function {name}")
        if name == "select" and len(args) == 1:
            setattr(invoke, "path_predicate", args[0])
        return invoke

    def filter_call(self, name: str) -> Node:
        def invoke(value: Any, env: Env) -> Iterator[Any]:
            argument = env.get(f"__filter__:{name}")
            if not isinstance(argument, tuple) or len(argument) != 2:
                raise RuntimeErrorJQ(f"missing filter argument {name}")
            argument_node, argument_env = argument
            yield from argument_node(value, argument_env)
        return invoke

    @staticmethod
    def discovered_paths(value: Any, prefix: list[Any] | None = None) -> Iterator[tuple[list[Any], Any]]:
        """Yield non-root paths in jq's depth-first, source-order traversal."""
        current = [] if prefix is None else prefix
        if isinstance(value, list):
            for index, item in enumerate(value):
                child_path = current + [index]
                yield child_path, item
                yield from Parser.discovered_paths(item, child_path)
        elif isinstance(value, dict):
            for key, item in value.items():
                child_path = current + [key]
                yield child_path, item
                yield from Parser.discovered_paths(item, child_path)

    @staticmethod
    def read_path(value: Any, path: list[Any]) -> Any:
        current = value
        for component in path:
            if isinstance(current, dict) and isinstance(component, str):
                current = current.get(component)
            elif isinstance(current, list) and isinstance(component, int) and not isinstance(component, bool):
                current = current[component] if 0 <= component < len(current) else None
            else:
                return None
        return current

    @staticmethod
    def function_call(function: FunctionDef, arguments: list[Node]) -> Node:
        def invoke(value: Any, env: Env) -> Iterator[Any]:
            if function.body is None:
                raise RuntimeErrorJQ(f"incomplete function {function.name}")
            if len(arguments) != function.arity:
                raise RuntimeErrorJQ(f"function {function.name} expects {function.arity} arguments")
            value_arguments: list[tuple[str, list[Any]]] = []
            child_base = dict(env)
            for (name, is_value), argument in zip(function.parameters, arguments):
                if is_value:
                    value_arguments.append((name, list(argument(value, env))))
                else:
                    child_base[f"__filter__:{name}"] = (argument, env)

            def run_values(index: int, child_env: Env) -> Iterator[Any]:
                if index == len(value_arguments):
                    yield from function.body(value, child_env)
                    return
                name, values = value_arguments[index]
                for item in values:
                    next_env = dict(child_env)
                    next_env[name] = item
                    yield from run_values(index + 1, next_env)

            yield from run_values(0, child_base)
        return invoke


def run(arguments: list[str], input_stream: Any, output_stream: Any) -> int:
    if len(arguments) != 2 or arguments[0] != "-c" or not arguments[1]:
        return 3
    try:
        program = Parser(arguments[1]).parse()
    except CompileError as error:
        print(f"jq: {error}", file=sys.stderr); return 3
    try:
        for line in input_stream:
            if line.strip():
                for result in program(json.loads(line), {}):
                    output_stream.write(json.dumps(result, separators=(",", ":"), ensure_ascii=False) + "\n")
    except HaltSignal:
        return 0
    except HaltErrorSignal as error:
        return error.code
    except (json.JSONDecodeError, OSError, RuntimeErrorJQ, TypeError, ValueError) as error:
        print(f"jq: {error}", file=sys.stderr); return 5
    return 0


if __name__ == "__main__":
    raise SystemExit(run(sys.argv[1:], sys.stdin, sys.stdout))
