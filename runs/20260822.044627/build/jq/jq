#!/usr/bin/env python3
"""Standalone jq executable entry point.

The interpreter package owns parsing and evaluation; this tiny launcher keeps
the application-root contract explicit and lets the file remain directly
executable without installation.
"""

from __future__ import annotations

from jq_interpreter.cli import main


def run() -> int:
    """Run the command-line interface and return its process status."""
    return main()


if __name__ == "__main__":
    raise SystemExit(run())
